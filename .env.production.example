# VENDOORA — Production environment template (placeholders only)
#
# Copy real values into the Render dashboard / production environment group.
# NEVER commit real secrets, API keys, or database connection strings.

# --- Shared with staging ----------------------------------------------------
# Identical variable names in every environment; only the VALUES differ.

# Public base URL of the production deployment (no trailing slash).
APP_URL="https://vendoora.onrender.com"

# Production database connection string. Provisioned by render.yaml as the
# `vendoora-postgres` instance; Render injects the real value, so this is
# normally NOT set manually.
DATABASE_URL="<injected-by-render-from-vendoora-postgres>"

# JWT signing secret. MUST be unique to production and at least 32 chars.
# Generate with: openssl rand -base64 48
JWT_SECRET="<production-only-secret-never-shared-with-staging>"

# Razorpay. Must be LIVE-mode keys in production.
RAZORPAY_KEY_ID="<rzp_live_xxxxxxxxxxxxxxxx>"
RAZORPAY_KEY_SECRET="<production-razorpay-live-secret>"
VITE_RAZORPAY_KEY_ID="<unused-by-app; safe to leave empty>"

# Cloudinary. Dedicated production cloud.
CLOUDINARY_CLOUD_NAME="<production-cloud-name>"
CLOUDINARY_API_KEY="<production-api-key>"
CLOUDINARY_API_SECRET="<production-api-secret>"

# --- Production-only tuning -------------------------------------------------
# Production logs stay concise; use `debug` only when actively investigating.
LOG_LEVEL="info"

# Must be `production` so server.ts serves dist/ instead of the Vite dev
# middleware, and so Prisma logs only `error` instead of every query.
NODE_ENV="production"
