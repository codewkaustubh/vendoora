# VENDOORA — Staging environment template (placeholders only)
#
# Copy real values into the Render dashboard / staging environment group.
# NEVER commit real secrets, API keys, or database connection strings.
#
# Import into Render with: render env-vars set --environment staging -f <file>
# (after replacing every placeholder).

# --- Shared with production -------------------------------------------------
# Identical variable names in every environment; only the VALUES differ.

# Public base URL of the staging deployment (no trailing slash).
APP_URL="https://vendoora-staging.onrender.com"

# Staging database connection string. Use the STAGING Postgres instance,
# never the production one.
DATABASE_URL="postgresql://vendoora:<password>@<staging-host>:5432/vendoora?schema=public"

# JWT signing secret. MUST be a different, independently generated value from
# production so a leaked staging token can never authenticate against prod.
# Generate with: openssl rand -base64 48
JWT_SECRET="<staging-only-secret-different-from-production>"

# Razorpay. Use the Razorpay TEST-mode keys in staging.
RAZORPAY_KEY_ID="<rzp_test_xxxxxxxxxxxxxxxx>"
RAZORPAY_KEY_SECRET="<staging-razorpay-test-secret>"
VITE_RAZORPAY_KEY_ID="<unused-by-app; safe to leave empty>"

# Cloudinary. Use a dedicated staging cloud or a folder prefix so staging
# uploads can never collide with production assets.
CLOUDINARY_CLOUD_NAME="<staging-cloud-name>"
CLOUDINARY_API_KEY="<staging-api-key>"
CLOUDINARY_API_SECRET="<staging-api-secret>"

# --- Staging-only tuning ----------------------------------------------------
# Logging verbosity. Staging can be noisier than production for debugging.
LOG_LEVEL="debug"

# NODE_ENV must be `production` for Render to serve the built SPA from dist/.
NODE_ENV="production"
